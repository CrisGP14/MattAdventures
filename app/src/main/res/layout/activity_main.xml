<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frmprincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- El juego en modo demostración: Matt corre y salta solo mientras carga -->
    <cristiangiovannigonzalezplascencia.mattadventures.JuegoView
        android:id="@+id/juegosplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="14dp">

        <ImageView
            android:id="@+id/imgsplashlogo"
            android:layout_width="330dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/ml" />

        <ProgressBar
            android:id="@+id/pbprogres"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="300dp"
            android:layout_height="16dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/barra_carga" />

        <TextView
            android:id="@+id/lblcargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:shadowColor="#AA000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text="Cargando"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblconsejo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#AA000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:textColor="#FFF9C4"
            android:textSize="14sp"
            android:textStyle="italic" />
    </LinearLayout>
</FrameLayout>
