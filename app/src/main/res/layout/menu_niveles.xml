<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1"
    android:id="@+id/fondo"
    android:background="@drawable/mundo2">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nivel 3"
        android:id="@+id/lbltres"
        android:textSize="20dp"
        android:fontFamily="serif"
        android:textStyle="normal|bold|italic"
        android:layout_marginEnd="43dp"
        android:layout_alignTop="@+id/lbldos"
        android:layout_alignParentEnd="true" />

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/mundo3"
        android:id="@+id/imgmundo3"
        android:layout_alignTop="@+id/imgmundo1"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="28dp" />

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/mundo2"
        android:id="@+id/imgmundo2"
        android:layout_alignTop="@+id/imgmundo1"
        android:layout_centerHorizontal="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Puntaje"
        android:id="@+id/lblpuntaje1"
        android:textSize="20dp"
        android:fontFamily="serif"
        android:textStyle="normal|bold|italic"
        android:layout_marginTop="34dp"
        android:layout_alignParentTop="true"
        android:layout_alignStart="@+id/lbluno" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Puntaje"
        android:id="@+id/lblpuntaje2"
        android:textSize="20dp"
        android:fontFamily="serif"
        android:textStyle="normal|bold|italic"
        android:layout_alignBaseline="@+id/lblpuntaje1"
        android:layout_alignBottom="@+id/lblpuntaje1"
        android:layout_alignEnd="@+id/lbldos" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Puntaje"
        android:id="@+id/lblpuntaje3"
        android:textSize="20dp"
        android:fontFamily="serif"
        android:textStyle="normal|bold|italic"
        android:layout_marginStart="9dp"
        android:layout_alignBaseline="@+id/lblpuntaje2"
        android:layout_alignBottom="@+id/lblpuntaje2"
        android:layout_alignStart="@+id/imgmundo3" />

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/mundo1"
        android:id="@+id/imgmundo1"
        android:layout_marginStart="35dp"
        android:layout_below="@+id/lblpuntaje1"
        android:layout_alignParentStart="true"
        android:layout_marginTop="31dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nivel 1"
        android:id="@+id/lbluno"
        android:textSize="20dp"
        android:fontFamily="serif"
        android:textStyle="normal|bold|italic"
        android:layout_marginStart="15dp"
        android:layout_below="@+id/imgmundo2"
        android:layout_alignStart="@+id/imgmundo1"
        android:layout_marginTop="11dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nivel 2"
        android:id="@+id/lbldos"
        android:textSize="20dp"
        android:fontFamily="serif"
        android:textStyle="normal|bold|italic"
        android:layout_alignBaseline="@+id/lbluno"
        android:layout_alignBottom="@+id/lbluno"
        android:layout_centerHorizontal="true" />


</RelativeLayout>